<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.network.columba.Columba</string>
	</array>
	<key>com.apple.developer.networking.networkextension</key>
	<array>
		<string>packet-tunnel-provider</string>
	</array>
	<!-- Multicast entitlement is required for AutoInterface (IPv6 link-local
	     multicast discovery) and Bonjour browsing on iOS 14+. Without it the
	     OS silently drops outbound multicast UDP — Python's RNS.AutoInterface
	     will appear to start but never see peers.

	     Granted on a per-app basis by Apple via:
	         https://developer.apple.com/contact/request/networking-multicast
	     until that's approved, the entitlement is honored on Simulator only
	     and ignored on real devices (provisioning profile will refuse to
	     embed it). Sideband and other RNS-on-iOS apps have it; Columba
	     should request the same. -->
	<key>com.apple.developer.networking.multicast</key>
	<true/>
</dict>
</plist>
